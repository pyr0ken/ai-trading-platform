{
  "name": "ai-trading-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start:frontend": "npm run start --prefix frontend",
    "test:frontend": "npm run test --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "start:backend": "cd backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "dev": "concurrently -n \"next,fastapi\" -c \"blue,green\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "test": "npm run test:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
